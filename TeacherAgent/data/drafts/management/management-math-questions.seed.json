    {
      "id": "management-math-q003",
      "title": "加权平均",
      "type": "diagnostic",
      "difficulty": 2,
      "content": "一组5人平均80分，另一组15人平均70分，全体平均约：",
      "answer": "A",
      "solutionSteps": [
        "总平均$=\\frac{(5\\times80+15\\times70)}{2}0=\\frac{(400+1050)}{2}0=72.5$。",
        "不能简单取$\\frac{(80+70)}{2}$。",
        "权重在人数。"
      ],
      "hints": [
        {
          "level": "L1",
          "text": "加权：总分$\\div$总人数。"
        },
        {
          "level": "L2",
          "text": "计算$=145\\frac{0}{2}0=72.5$。"
        },
        {
          "level": "L3",
          "text": "选A。"
        }
      ],
