{
  "name": "teacher-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
  "test:protocol-mirror": "node --test scripts/verify-protocol-mirror.node-test.mjs",
    "test:watch": "vitest",
    "preview": "vite preview",
    "sidecar:hashes": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-sidecar-hashes.ps1",
    "verify:alerttime-offline": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-alerttime-offline-loop.ps1",
    "build:tauri-pre": "npm run sidecar:hashes && npm run build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@tauri-apps/api": "^2.0.0",
    "chart.js": "^4.5.1",
    "dompurify": "^3.4.12",
    "glob": "^13.0.6",
    "katex": "^0.16.11",
    "markdown-it": "^14.1.0",
    "pinia": "^2.3.0",
    "qrcode": "^1.5.4",
    "shiki": "^1.24.0",
    "v-network-graph": "^0.9.23",
    "vue": "^3.5.0",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^4.5.0",
    "vuetify": "^3.7.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.2.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.9",
    "vue-tsc": "^2.1.0"
  }
}
